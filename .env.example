# Environment Mode
ENV=development
DEBUG=True
PROJECT_NAME="Zem API"

# Databases & Infrastructure Connections
# PostgreSQL URL (for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zem_db

# Redis connection URL (for RQ & Caching)
REDIS_URL=redis://localhost:6379/0

# local Ollama instance (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# 🔑 PAID & PREMIUM CLOUD PROVIDER KEYS
# ==========================================
# Required for premium nodes (OpenAI, Mistral, Claude, Gemini)
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
HF_API_TOKEN=your_huggingface_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=AIzaSyCjGaF7_UffyKcSYKaseFTiGyrVsaaBKMA
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# 🔊 NARRATION & TTS API KEYS
# ==========================================
# Required if routing narration through Sarvam, ElevenLabs, or Murf
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=4fcf3611fefbdeb3fa21e2844a2038a36cf595e97ba80f74cf3e2528b7e1c247
MURF_API_KEY=ap2_284b65bf-5367-4f02-b5b2-541f6c535a8c

# ==========================================
# ⚙️ PROVIDER ACTIVATION FLAGS
# ==========================================
ENABLE_OPENAI=true
ENABLE_CLAUDE=false
ENABLE_GEMINI=false
ENABLE_MISTAL=true
ENABLE_HF=true
ENABLE_OLLAMA=true
ENABLE_KOKORO=true
ENABLE_SARVAM=true
ENABLE_MURF=false

# ==========================================
# 🤖 TWITTER/X API & SCRAPING SETTINGS
# ==========================================
ENABLE_TWITTER=true

# Twitter/X API v2 Keys
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# Scraping Fallbacks
ENABLE_TWIKIT=true
ENABLE_SNSCRAPE=true

# ==========================================
# 📁 LOCAL PATHS & ENGINE SETTINGS
# ==========================================
# Local Kokoro model file path (if custom path needed)
KOKORO_MODEL_PATH=

# FFmpeg binary path
FFMPEG_BINARY=ffmpeg

# LangGraph checkpoint backend (redis or memory)
LANGGRAPH_CHECKPOINT_BACKEND=redis

# ==========================================
# 🚀 RENDERING & WORKERS
# ==========================================
# GPU accelerated rendering
ENABLE_GPU_RENDERING=false

# Worker concurrency
MAX_RENDER_WORKERS=2
MAX_VRAM_GB=8.0
LOCAL_MODEL_SIZE=auto
