# ======================================================================
# ZEM AUTONOMOUS MEDIA OPERATING SYSTEM -- ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================================

# ENVIRONMENT MODE
ENV=development
DEBUG=True
PROJECT_NAME="Zem API"

# ======================================================================
# CORE INFRASTRUCTURE
# ======================================================================

# DATABASE (Used if DATABASE_URL is not set directly)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zem_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Direct connection URL (Legacy fallback/override)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/zem_db

# REDIS (Used if REDIS_URL is not set directly)
REDIS_HOST=localhost
REDIS_PORT=6379

# Direct connection URL (Legacy fallback/override)
REDIS_URL=redis://localhost:6379/0

# RABBITMQ (Used if RABBITMQ_URL is not set directly)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Direct connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ======================================================================
# TWITTER/X DISCOVERY
# ======================================================================
ENABLE_TWITTER=false

# Twitter/X API v2 Credentials
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# Scraping Fallbacks
ENABLE_TWIKIT=true
ENABLE_SNSCRAPE=true

# ======================================================================
# HUGGINGFACE (Local LLM & Embeddings Engine)
# ======================================================================
HF_ENABLED=true
HF_DEFAULT_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_MODEL_CACHE=./models/huggingface
HF_DEVICE=auto
HF_ENABLE_QUANTIZATION=true
HF_MAX_NEW_TOKENS=512
HF_ENABLE_FALLBACKS=true
HUGGINGFACE_API_KEY=your_hf_api_key_here
HF_HOME=.cache/huggingface

# ======================================================================
# OPTIONAL PREMIUM LLMs
# ======================================================================
ENABLE_OPENAI=false
OPENAI_API_KEY=your_openai_api_key_here

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here

ENABLE_GEMINI=false
GOOGLE_API_KEY=your_google_api_key_here

# ======================================================================
# TTS (Text to Speech Engines)
# ======================================================================
ENABLE_KOKORO=true
# KOKORO_MODEL_PATH: Absolute path to the local Kokoro weights and config directory.
# Should contain 'kokoro-v0_19.pth' (or other version) and 'config.json'.
# Leave blank to auto-download weights from Hugging Face cache on the first run.
KOKORO_MODEL_PATH=

# Sarvam Multilingual TTS
ENABLE_SARVAM=false
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional Premium TTS Engines
ENABLE_MURF=false
MURF_API_KEY=your_murf_api_key_here

# ElevenLabs TTS
ENABLE_ELEVENLABS=false
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ======================================================================
# SUBTITLES (Local Transcription Engines)
# ======================================================================
ENABLE_FASTER_WHISPER=true
WHISPER_MODEL=base

# ======================================================================
# RENDERING
# ======================================================================
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ENABLE_GPU_RENDERING=false

# ======================================================================
# LANGGRAPH
# ======================================================================
# Set to 'memory' to bypass Redis for local development checkpointing
LANGGRAPH_CHECKPOINT_BACKEND=memory

# ======================================================================
# WORKERS
# ======================================================================
MAX_RENDER_WORKERS=2
MAX_PIPELINE_WORKERS=4
MAX_VRAM_GB=8.0
LOCAL_MODEL_SIZE=auto
