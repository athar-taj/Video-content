# Environment Mode
ENV=development
DEBUG=True
PROJECT_NAME="Zem API"

# Databases & Infrastructure Connections
# PostgreSQL URL (for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zem_db

# Redis connection URL (for RQ & Caching)
REDIS_URL=redis://localhost:6379/0

# local Ollama instance (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# 🔑 LLM API KEYS
# ==========================================
# Required for premium nodes (OpenAI, Mistral)
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
HF_API_TOKEN=your_huggingface_token_here

# ==========================================
# 🔊 TTS API KEYS
# ==========================================
# Required if routing narration through Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here

# ==========================================
# 🤖 REDDIT API CREDENTIALS
# ==========================================
# Required for Content Discovery fetching
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT="ZemMediaEngine/0.1"
